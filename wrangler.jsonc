{
  "name": "metashelf",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/*.md"] },
  "kv_namespaces": [{ "binding": "FILES", "id": "e94cb4ecb47b4f218b307607446ff424" }],
  "routes": [{ "pattern": "metashelf.dev", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
